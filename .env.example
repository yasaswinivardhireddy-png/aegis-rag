# Copy to .env locally. Never commit your keys.
# Default provider: Google Gemini free tier. Create a key at https://aistudio.google.com/apikey
# Free-tier prompts may be used to improve Google products; use non-sensitive data only.
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3.5-flash
# Sent as reasoning_effort. Leave empty to omit it for providers that reject the parameter.
LLM_REASONING_EFFORT=low
EMBEDDING_MODEL=gemini-embedding-001
# Optional: minimum cosine similarity for a section to count as relevant.
MIN_RELEVANCE=
PORT=4318
